on boot
    # android.c's android_usb FunctionFS path (drivers/usb/gadget/android.c
    # #include "f_fs.c") is what this kernel's adbd runs over; the same
    # three properties device/htc/msm8974-common's own ROM-side
    # init.recovery.qcom.rc sets, unconditional on hardware.
    setprop sys.usb.ffs.aio_compat 1
    setprop persist.adb.nonblocking_ffs 0
    setprop ro.adb.nonblocking_ffs 0
