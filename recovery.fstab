# SPDX-License-Identifier: Apache-2.0
# TWRP fstab: <Mount Point> <Fstype> <Block Device> [<Length>] [flags=...]
#
# By-name paths lifted from device/htc/msm8974-common's own
# rootdir/etc/fstab.qcom, the fstab this device's own ueventd already
# builds these /dev/block/platform/msm_sdcc.1/by-name/* links for.
# RECOVERY_SDCARD_ON_DATA in BoardConfig.mk maps TWRP's "Internal Storage"
# onto /data/media: this device has no dedicated sdcard partition
# (DEVICE_STATE.md: "no external SD card -- internal storage only").
#
# /cache is ext4, not the f2fs BoardConfigCommon.mk declares as its
# preferred type: this partition's f2fs superblock is invalid on the
# flashed device (libfs_mgr's own fallback log,
# evidence/camera-root-cause/logcat-kernel.txt:1655-1666, "Invalid f2fs
# superblock ... mount(...,ext4)=0: Success"), so the physical format is
# ext4 regardless of the ROM tree's declared preference.

/boot           emmc        /dev/block/platform/msm_sdcc.1/by-name/boot          flags=backup=1
/recovery       emmc        /dev/block/platform/msm_sdcc.1/by-name/recovery      flags=backup=1
/misc           emmc        /dev/block/platform/msm_sdcc.1/by-name/misc         flags=backup=0
/system         ext4        /dev/block/platform/msm_sdcc.1/by-name/system        flags=backup=1;wipeingui;
/cache          ext4        /dev/block/platform/msm_sdcc.1/by-name/cache        flags=backup=1;wipeingui;wipeduringfactoryreset;canencryptbackup=1
/data           ext4        /dev/block/platform/msm_sdcc.1/by-name/userdata     flags=backup=1;wipeingui;wipeduringfactoryreset;canencryptbackup=1;userdataencryptbackup=1

# Firmware partitions the ROM's own fstab.qcom mounts read-only for HAL use;
# recoveryonly in that fstab, kept read-only here too. Neither is written by
# any tool in this tree (HTC AGENTS.md hard boundary: firmware scope is
# system and boot only).
/firmware/radio vfat        /dev/block/platform/msm_sdcc.1/by-name/radio        flags=backup=0
/firmware/adsp  vfat        /dev/block/platform/msm_sdcc.1/by-name/adsp         flags=backup=0

# USB-OTG: every M8 board revision exposes this; no physical microSD slot on
# the whl (Sprint) hardware, so no /external_sd entry.
/usb-otg        vfat        /dev/block/sda1        /dev/block/sda     flags=display="USB-OTG";storage;wipeingui;removable
