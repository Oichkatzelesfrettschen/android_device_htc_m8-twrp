From: Pierre-Hugues Husson <phh@phh.me>
Subject: init: Fix support for devices without cgroupv2 support

This kernel's compat cgroup2 filesystem does not cover every path
libprocessgroup's createProcessGroup() takes; device/htc/msm8974-common's
own ROM build (lineage-22.2-m8) carries this exact patch (source:
Ultra-Legacy-Hippeastrum/android_system_core@lineage-22.2, commit
99dd39e391246da743cf5ce32f545f294f819600), because a failed
createProcessGroup() otherwise aborts the service instead of merely
logging it. Applied to bootable_recovery's own init on this manifest,
which carries the same fatal path unmodified.
---
--- a/init/service.cpp
+++ b/init/service.cpp
@@ -719,12 +719,15 @@ Result<void> Service::Start() {
                          limit_percent_ != -1 || !limit_property_.empty();
         errno = -createProcessGroup(uid(), pid_, use_memcg);
         if (errno != 0) {
+            PLOG(ERROR) << "createProcessGroup(" << uid() << ", " << pid_ <<  ") failed for service '" << name_ << "'";
+#if 0
             Result<void> result = cgroups_activated.Write(kActivatingCgroupsFailed);
             if (!result.ok()) {
                 return Error() << "Sending notification failed: " << result.error();
             }
             return Error() << "createProcessGroup(" << uid() << ", " << pid_ << ", " << use_memcg
                            << ") failed for service '" << name_ << "': " << strerror(errno);
+#endif
         }

         // When the blkio controller is mounted in the v1 hierarchy, NormalIoPriority is
